; Engine configuration file.
; Godot 4.7.2-stable — locked by Lead.
config_version=5

[application]

config/name="Quiet Mansion"
config/description="2D stealth roguelite — flashlight, noise, puppet-hand horrors."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
AssetProvenance="*res://scripts/autoload/asset_provenance.gd"
FESignals="*res://scripts/ui/fe_signals.gd"

